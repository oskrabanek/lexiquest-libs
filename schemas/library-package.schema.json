{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LexiQuest Library Package Root",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest", "adventure"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "formatVersion",
        "id",
        "version",
        "name",
        "languages",
        "authors",
        "license",
        "adventure",
        "dictionary",
        "quests"
      ],
      "properties": {
        "formatVersion": {
          "anyOf": [
            { "type": "integer", "const": 1 },
            { "type": "string", "pattern": "^1(?:\\.\\d+)?$" }
          ]
        },
        "id": { "type": "string", "minLength": 1 },
        "version": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "number" }
          ]
        },
        "name": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "description": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          ]
        },
        "languages": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 2 }
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "license": { "type": "string", "minLength": 1 },
        "adventure": { "type": "string", "minLength": 1 },
        "dictionary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "quests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adventure": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
